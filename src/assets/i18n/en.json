  "help": {
    "title": "Help Center",
    "subtitle": "Everything you need to know about using Hawalaty to run your daily orders and sales.",
    "about": {
      "title": "What is Hawalaty?",
      "text": "Hawalaty is your point-of-sale and order management system for بيت التميس. Record every order as a transfer — paid in cash or through a bank/wallet — manage your menu and its categories, track full order history, export professional reports, and keep your banks and wallets up to date, all in one bilingual, dark-mode-ready workspace."
    },
    "featuresTitle": "What each page does",
    "openPage": "Open page",
    "features": {
      "dashboard": "Your daily snapshot: today's sales, quick actions, recent expenses and a weekly sales trend at a glance.",
      "transfers": "Send a standalone transfer with a fee breakdown and confirmation summary.",
      "history": "The full archive of past orders, searchable and filterable by status and payment method.",
      "banks": "Manage the banks and wallets used for payments and giving change back to customers.",
      "menu": "Manage your menu items, prices and availability, organized by category.",
      "expenses": "Log what your business bought and which bank or wallet paid for it.",
      "reports": "Generate and export a professional PDF report with totals and averages.",
      "constants": "Business-wide values, like the menu's categories, editable from one place.",
      "settings": "Your profile, security and language preferences."
    },
    "faq": {
      "title": "Frequently asked questions",
      "newOrder": {
        "q": "How do I record a new order?",
        "a": "Click \"New Transfer\" from the sidebar or the Send quick action on the Dashboard, add items from the menu, then choose whether the customer paid in cash or through a bank/wallet."
      },
      "addCategory": {
        "q": "How do I add a new menu category?",
        "a": "Open Constants → Menu Categories, type the new category name and click Add. It appears immediately in the Menu page's filters and in the item form."
      },
      "exportReport": {
        "q": "How do I export a report?",
        "a": "Open the Reports page and click \"Export PDF\" — the report is generated from your transfer history, ready to save or print."
      },
      "language": {
        "q": "How do I switch language or dark mode?",
        "a": "Use the language toggle (English / العربية) and the sun/moon icon in the top header — both are available on every page and your choice is remembered."
      },
      "banksVsWallets": {
        "q": "What's the difference between a bank and a wallet?",
        "a": "Banks require a SWIFT/BIC code, wallets don't. Add either from the Banks & Wallets page and pick the right type — this affects what payment and change options appear in the order form."
      }
    },
    "support": {
      "title": "Still need help?",
      "desc": "Reach out and we'll walk you through it.",
      "action": "Contact support"
    }
  },
